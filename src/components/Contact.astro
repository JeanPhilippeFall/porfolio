---
import { site, ui } from "../data/cv";
import Bi from "./Bi.astro";
---

<section id="contact" class="px-5 py-20">
  <div class="reveal mx-auto max-w-3xl rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center dark:border-slate-800 dark:bg-slate-900/50 sm:p-12">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">
      <Bi text={ui.contactTitle} />
    </h2>
    <p class="mt-2 text-slate-500 dark:text-slate-400">
      <Bi text={ui.contactSubtitle} />
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href={`mailto:${site.email}`}
        class="inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:opacity-90"
      >
        {site.email}
      </a>
      <a
        href={`tel:${site.phone.replace(/\s/g, "")}`}
        class="inline-flex items-center gap-2 rounded-full border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-700 transition hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-200"
      >
        {site.phone}
      </a>
    </div>

    <div class="mt-6 flex items-center justify-center gap-4 text-sm font-medium text-slate-500 dark:text-slate-400">
      <a href={site.socials.linkedin} target="_blank" rel="noreferrer" class="hover:text-accent">LinkedIn</a>
      <span aria-hidden="true">·</span>
      <a href={site.socials.github} target="_blank" rel="noreferrer" class="hover:text-accent">GitHub</a>
    </div>
  </div>
</section>
