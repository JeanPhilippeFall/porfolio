---
import { nav, site } from "../data/cv";
import Bi from "./Bi.astro";
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur dark:border-slate-800/70 dark:bg-slate-950/80">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-3">
    <a href="#top" class="flex items-center gap-2 font-semibold text-slate-900 dark:text-white">
      <img src="/icons/Jean-Phillipe.ico" alt={site.name} class="h-8 w-8 rounded-full object-cover" width="48" height="48" />
      <span class="hidden sm:inline text-slate-400 dark:text-slate-500">{site.name}</span>
    </a>

    <nav class="hidden md:flex items-center gap-6 text-sm">
      {nav.map((item) => (
        <a data-nav-link href={`#${item.id}`} class="text-slate-600 transition-colors hover:text-accent dark:text-slate-300">
          <Bi text={item.label} />
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <button
        data-lang-switch
        type="button"
        aria-label="Switch language"
        class="h-9 w-9 rounded-full border border-slate-200 text-xs font-semibold text-slate-600 transition hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-300"
      >EN</button>
      <button
        data-theme-switch
        type="button"
        aria-label="Switch theme"
        class="h-9 w-9 rounded-full border border-slate-200 text-slate-600 transition hover:border-accent hover:text-accent dark:border-slate-700 dark:text-slate-300"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="mx-auto h-4 w-4 dark:hidden">
          <path d="M12 3v2m0 14v2m9-9h-2M5 12H3m14.95 6.95-1.41-1.41M6.46 6.46 5.05 5.05m12.49 0-1.41 1.41M6.46 17.54l-1.41 1.41" />
          <circle cx="12" cy="12" r="4" />
        </svg>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mx-auto hidden h-4 w-4 dark:block">
          <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79Z" />
        </svg>
      </button>
      <button data-nav-toggle type="button" aria-label="Menu" class="h-9 w-9 rounded-full border border-slate-200 text-slate-600 md:hidden dark:border-slate-700 dark:text-slate-300">
        ☰
      </button>
    </div>
  </div>

  <nav data-nav-menu class="hidden border-t border-slate-200 bg-white px-5 py-3 md:hidden dark:border-slate-800 dark:bg-slate-950">
    <ul class="flex flex-col gap-3 text-sm">
      {nav.map((item) => (
        <li>
          <a href={`#${item.id}`} class="text-slate-600 dark:text-slate-300">
            <Bi text={item.label} />
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
