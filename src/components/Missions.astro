---
import { missions } from "../data/cv";
import Bi from "./Bi.astro";
import TechIcon from "./TechIcon.astro";

const title = { fr: "Missions clés", en: "Key missions" };
const subtitle = {
  fr: "Plateformes conçues, développées et maintenues chez IAD-Territoire-Digital.",
  en: "Platforms designed, developed and maintained at IAD-Territoire-Digital.",
};
---

<section id="missions" class="px-5 py-10">
  <div class="reveal mx-auto max-w-3xl">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">
      <Bi text={title} />
    </h2>
    <p class="mt-2 text-slate-500 dark:text-slate-400">
      <Bi text={subtitle} />
    </p>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {missions.map((mission) => (
        <article class="rounded-2xl border border-slate-200 p-5 transition hover:border-accent/50 hover:shadow-sm dark:border-slate-800">
          <h3 class="font-semibold text-slate-900 dark:text-white">{mission.name}</h3>
          <p class="mt-1 text-xs text-slate-400 dark:text-slate-500">
            <Bi text={mission.client} />
          </p>
          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <Bi text={mission.description} />
          </p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            {mission.stack.map((tech) => <TechIcon name={tech} />)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
