---
import { skills } from "../data/cv";
import Bi from "./Bi.astro";

const title = { fr: "Compétences", en: "Skills" };
---

<section id="skills" class="px-5 py-10">
  <div class="reveal mx-auto max-w-3xl">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">
      <Bi text={title} />
    </h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {skills.map((group) => (
        <div>
          <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">
            <Bi text={group.title} />
          </h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span class="rounded-full border border-slate-200 px-3 py-1 text-xs font-medium text-slate-600 dark:border-slate-700 dark:text-slate-300">
                {item}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
