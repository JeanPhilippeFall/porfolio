---
import { experiences } from "../data/cv";
import Bi from "./Bi.astro";

const title = { fr: "Expérience", en: "Experience" };
---

<section id="experience" class="px-5 py-10">
  <div class="reveal mx-auto max-w-3xl">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">
      <Bi text={title} />
    </h2>

    <ol class="mt-8 space-y-10 border-l border-slate-200 pl-6 dark:border-slate-800">
      {experiences.map((exp) => (
        <li class="relative">
          <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-accent dark:border-slate-950"></span>

          <p class="text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500">
            <Bi text={exp.period} />
          </p>
          <h3 class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">
            <Bi text={exp.role} as="span" /> · {exp.company}
          </h3>
          <p class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
            <span>{exp.location}</span>
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">
              <Bi text={exp.workMode} as="span" />
            </span>
          </p>

          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            {exp.bullets.map((bullet) => (
              <li class="flex gap-2">
                <span class="mt-2 h-1 w-1 flex-none rounded-full bg-slate-400 dark:bg-slate-600"></span>
                <Bi text={bullet} as="span" />
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
